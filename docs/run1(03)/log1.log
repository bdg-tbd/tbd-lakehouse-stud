  # snowflake_masking_policy.pii_string will be created
  + resource "snowflake_masking_policy" "pii_string" {
      + body                  = <<-EOT
            CASE
              -- Only the primary role counts: secondary roles must never unmask data.
              WHEN CURRENT_ROLE() IN ('PII_ADMIN', 'PIPELINE_ADMIN') THEN val
              WHEN CURRENT_ROLE() = 'SUPPORT' THEN
                CASE SYSTEM$GET_TAG_ON_CURRENT_COLUMN('LAKEHOUSE.GOVERNANCE.PII_TYPE')
                  WHEN 'NAME'  THEN LEFT(val, 1) || '***'
                  WHEN 'EMAIL' THEN '***@' || SPLIT_PART(val, '@', 2)
                  WHEN 'PHONE' THEN '***' || RIGHT(REGEXP_REPLACE(val, '[^0-9]', ''), 4)
                  WHEN 'IP'    THEN SPLIT_PART(val, '.', 1) || '.' || SPLIT_PART(val, '.', 2) || '.x.x'
                  WHEN 'CARD'  THEN val
                  ELSE '***'
                END
              ELSE '***'
            END
        EOT
      + comment               = "PII_TYPE-driven masking for text columns"
      + database              = "LAKEHOUSE"
      + describe_output       = (known after apply)
      + exempt_other_policies = "default"
      + fully_qualified_name  = (known after apply)
      + id                    = (known after apply)
      + name                  = "MP_PII_STRING"
      + return_data_type      = "VARCHAR(16777216)"
      + schema                = "GOVERNANCE"
      + show_output           = (known after apply)

      + argument {
          + name = "VAL"
          + type = "VARCHAR(16777216)"
        }
    }

