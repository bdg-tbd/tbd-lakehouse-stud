  # snowflake_procedure_sql.start_all will be created
  + resource "snowflake_procedure_sql" "start_all" {
      + comment               = "Resume pipelines unless RM_LAB is exhausted (mise run start)"
      + database              = "LAKEHOUSE"
      + enable_console_output = (known after apply)
      + execute_as            = "OWNER"
      + fully_qualified_name  = (known after apply)
      + id                    = (known after apply)
      + is_secure             = "default"
      + log_event_level       = (known after apply)
      + log_level             = (known after apply)
      + metric_level          = (known after apply)
      + name                  = "START_ALL"
      + parameters            = (known after apply)
      + procedure_definition  = <<-EOT
            -- Resume pipelines after `mise run stop`. Refuses once RM_LAB has used the whole cap.
            DECLARE
              log VARCHAR DEFAULT '';
              stmts ARRAY DEFAULT ARRAY_CONSTRUCT();
              used FLOAT DEFAULT 0;
              quota FLOAT DEFAULT 1;
              rs RESULTSET;
            BEGIN
              SHOW RESOURCE MONITORS LIKE 'RM_LAB';
              SELECT COALESCE(MAX("used_credits"::FLOAT), 0), COALESCE(MAX("credit_quota"::FLOAT), 1)
                INTO :used, :quota FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()));
              IF (used >= quota) THEN
                RETURN 'refused: RM_LAB has used ' || used || ' of ' || quota || ' credits';
              END IF;

              SHOW PIPES IN DATABASE LAKEHOUSE;
              rs := (SELECT 'ALTER PIPE IF EXISTS "' || "database_name" || '"."' || "schema_name" || '"."' || "name" || '" SET PIPE_EXECUTION_PAUSED = FALSE' AS s
                     FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())));
              FOR r IN rs DO stmts := ARRAY_APPEND(stmts, r.s); END FOR;

              SHOW DYNAMIC TABLES IN DATABASE LAKEHOUSE;
              rs := (SELECT 'ALTER DYNAMIC TABLE IF EXISTS "' || "database_name" || '"."' || "schema_name" || '"."' || "name" || '" RESUME' AS s
                     FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) WHERE "scheduling_state" = 'SUSPENDED');
              FOR r IN rs DO stmts := ARRAY_APPEND(stmts, r.s); END FOR;

              SHOW TASKS IN DATABASE LAKEHOUSE;
              rs := (SELECT 'ALTER TASK IF EXISTS "' || "database_name" || '"."' || "schema_name" || '"."' || "name" || '" RESUME' AS s
                     FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) WHERE "state" = 'suspended');
              FOR r IN rs DO stmts := ARRAY_APPEND(stmts, r.s); END FOR;

              stmts := ARRAY_APPEND(stmts, 'ALTER USER IF EXISTS INGEST_SVC SET DISABLED = FALSE');

              FOR i IN 0 TO ARRAY_SIZE(stmts) - 1 DO
                LET s VARCHAR := stmts[i];
                BEGIN
                  EXECUTE IMMEDIATE :s;
                  log := log || 'ok: ' || s || '\n';
                EXCEPTION
                  WHEN OTHER THEN
                    log := log || 'skipped: ' || s || ' (' || SQLERRM || ')\n';
                END;
              END FOR;
              RETURN log;
            END;
        EOT
      + procedure_language    = (known after apply)
      + return_type           = "VARCHAR(16777216)"
      + schema                = "OPS"
      + show_output           = (known after apply)
      + trace_level           = (known after apply)
    }

  # snowflake_procedure_sql.stop_all will be created
  + resource "snowflake_procedure_sql" "stop_all" {
      + comment               = "Suspend everything that can spend credits (mise run stop; budget action)"
      + database              = "LAKEHOUSE"
      + enable_console_output = (known after apply)
      + execute_as            = "OWNER"
      + fully_qualified_name  = (known after apply)
      + id                    = (known after apply)
      + is_secure             = "default"
      + log_event_level       = (known after apply)
      + log_level             = (known after apply)
      + metric_level          = (known after apply)
      + name                  = "STOP_ALL"
      + parameters            = (known after apply)
      + procedure_definition  = <<-EOT
            -- Suspend every object in LAKEHOUSE that can spend credits. Safe to call repeatedly and
            -- when objects don't exist yet. Used by `mise run stop` and the budget custom action.
            DECLARE
              log VARCHAR DEFAULT '';
              stmts ARRAY DEFAULT ARRAY_CONSTRUCT();
              rs RESULTSET;
            BEGIN
              SHOW TASKS IN DATABASE LAKEHOUSE;
              rs := (SELECT 'ALTER TASK IF EXISTS "' || "database_name" || '"."' || "schema_name" || '"."' || "name" || '" SUSPEND' AS s
                     FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) WHERE "state" = 'started' AND "name" <> 'NIGHTLY_STOP');
              FOR r IN rs DO stmts := ARRAY_APPEND(stmts, r.s); END FOR;

              SHOW DYNAMIC TABLES IN DATABASE LAKEHOUSE;
              rs := (SELECT 'ALTER DYNAMIC TABLE IF EXISTS "' || "database_name" || '"."' || "schema_name" || '"."' || "name" || '" SUSPEND' AS s
                     FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())) WHERE "scheduling_state" <> 'SUSPENDED');
              FOR r IN rs DO stmts := ARRAY_APPEND(stmts, r.s); END FOR;

              SHOW PIPES IN DATABASE LAKEHOUSE;
              rs := (SELECT 'ALTER PIPE IF EXISTS "' || "database_name" || '"."' || "schema_name" || '"."' || "name" || '" SET PIPE_EXECUTION_PAUSED = TRUE' AS s
                     FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())));
              FOR r IN rs DO stmts := ARRAY_APPEND(stmts, r.s); END FOR;

              stmts := ARRAY_CAT(stmts, ARRAY_CONSTRUCT(
                'ALTER USER IF EXISTS INGEST_SVC SET DISABLED = TRUE',
                'ALTER WAREHOUSE IF EXISTS WH_TRANSFORM SUSPEND',
                'ALTER WAREHOUSE IF EXISTS WH_QUERY SUSPEND'));

              FOR i IN 0 TO ARRAY_SIZE(stmts) - 1 DO
                LET s VARCHAR := stmts[i];
                BEGIN
                  EXECUTE IMMEDIATE :s;
                  log := log || 'ok: ' || s || '\n';
                EXCEPTION
                  WHEN OTHER THEN
                    -- e.g. warehouse already suspended
                    log := log || 'skipped: ' || s || ' (' || SQLERRM || ')\n';
                END;
              END FOR;
              RETURN log;
            END;
        EOT
      + procedure_language    = (known after apply)
      + return_type           = "VARCHAR(16777216)"
      + schema                = "OPS"
      + show_output           = (known after apply)
      + trace_level           = (known after apply)
    }

