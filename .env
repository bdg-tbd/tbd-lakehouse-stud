# Copy to .env (gitignored) and fill in. mise loads it automatically.

# Semester label, e.g. 2026z (winter) or 2027l (summer). Lowercase letters/digits/hyphens.
TF_VAR_semester=2026z
# Your team number or short name (at most 11 chars). Project IDs become tbd-<semester>-stud<team_id>-mgmt/-data, e.g. tbd-2026z-stud07-data.
TF_VAR_team_id=03b
# Billing account created when you redeemed the GCP coupon (Billing > Account management), e.g. 01ABCD-23EF45-6789AB
TF_VAR_billing_account=01FF8D-043129-5C231B
# Where GCP and Snowflake budget alerts go. Use the email you registered the Snowflake trial with (it must be verified there).
TF_VAR_notification_email=piolad2003@gmail.com
# Optional: instructors who get read-only access to your GCP projects, as a JSON list.
TF_VAR_supervisor_emails=[]
# Snowflake account identifier <org>-<account>, e.g. ABCDEFG-XY12345
# (Snowsight: account menu > View account details > Account identifier).
SNOWFLAKE_ACCOUNT=AWLVJAV-BF09434
